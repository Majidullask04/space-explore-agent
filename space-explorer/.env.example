# NASA Space Explorer - Environment Configuration

# NASA API Key (defaults to DEMO_KEY for public endpoints)
# Get a free key from: https://api.nasa.gov/
# DEMO_KEY is pre-configured for public NASA data endpoints
NASA_API_KEY=DEMO_KEY

# Optional: LLM provider configuration for the Agentic Space Guide
# Uncomment and configure one of the following to enable AI mission planning

# OpenAI provider
# OPENAI_API_KEY=sk-your-openai-key
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4o-mini

# Google Gemini provider  
# AGENT_API_KEY=your-gemini-key
# AGENT_PROVIDER=gemini
# AGENT_MODEL=gemini-2.0-flash

# Server configuration
PORT=5175